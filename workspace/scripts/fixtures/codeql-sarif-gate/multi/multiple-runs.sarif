          "ruleIndex": 0,
          "message": {
            "text": "Multiple run high severity"
          }
        },
        {
          "ruleIndex": 1,
          "message": {
            "text": "Multiple run low severity"
          }
        }
      ]
    },
    {
      "tool": {
        "driver": {
          "name": "CodeQL",
          "version": "0.0.0",
          "rules": [
            {
              "id": "MR-3",
              "properties": {
                "security-severity": "9.0"
              }
            }
          ]
        }
      },
      "results": [
        {
          "ruleIndex": 0,
