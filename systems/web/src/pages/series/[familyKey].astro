    padding: 0.2rem 0.55rem;
    border-radius: 999px;
  }
  .hz-series__badge--soon {
    color: var(--hz-brand, #7dd3a8);
    background: color-mix(in srgb, var(--hz-brand, #7dd3a8) 14%, transparent);
  }
  .hz-series__badge--past {
    color: var(--hz-text-faint, #8a857a);
    background: var(--hz-bg-raised, rgba(255, 255, 255, 0.05));
  }
  .hz-series__resolve {
    margin-top: 2.25rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--hz-border-faint, rgba(255, 255, 255, 0.07));
  }
  .hz-series__resolve-link {
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--hz-text-soft, #cfcabb);
    text-decoration: none;
  }
  .hz-series__resolve-link:hover {
    color: var(--hz-text, #f4f1ea);
  }
  .hz-series--empty {
    text-align: center;
    padding-top: 4rem;
  }
</style>
