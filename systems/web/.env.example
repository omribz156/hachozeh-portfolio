# Public browser analytics IDs. Values are public, but real env files stay local.
PUBLIC_GA4_MEASUREMENT_ID=
PUBLIC_POSTHOG_KEY=
PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com
PUBLIC_SENTRY_DSN=
PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0

# Server-side Sentry uses the same DSN unless a separate server DSN is needed.
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0

# Optional: only needed for Sentry source-map uploads during build.
SENTRY_AUTH_TOKEN=
