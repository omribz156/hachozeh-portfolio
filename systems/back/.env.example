# Local evaluation only. Keep real credentials outside version control.
# Load order: explicit NAVI_ENV_FILE, then package-local .env.
# This file is key documentation only — do not put real secrets in the repo.
NODE_ENV=development
SERVICE_NAME=navi-backend
HOST=0.0.0.0
PORT=3001
LOG_LEVEL=info
DEMO_ACTOR_MODE_ENABLED=false
DEMO_ACTOR_ID=seed_user_1
AUTH_SESSION_COOKIE_NAME=navi_session
AUTH_SESSION_TTL_HOURS=168
AUTH_OTP_TTL_MINUTES=10
AUTH_OTP_RESEND_COOLDOWN_SECONDS=30
AUTH_OTP_MAX_ATTEMPTS=5
AUTH_DEV_OTP_CODE=111111
# operator/test convenience: fixed OTP echoed in the auth response.
# default-closed; production refuses to boot with it on. flip to true only
# while running local smokes/gauntlets.
AUTH_DEV_OTP_EXPOSED=false
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://127.0.0.1:3001/api/auth/google/callback
GOOGLE_OAUTH_STATE_SECRET=

# optional script helper; backend runtime itself does not require this
BACKEND_BASE_URL=http://127.0.0.1:3001

# app-facing DB connection env
DB_HOST=127.0.0.1
DB_PORT=55432
DB_NAME=navi
DB_USER=navi
DB_PASSWORD=navi
DB_CONNECT_TIMEOUT_MS=10000
DB_POOL_MAX=30

# optional Oracle source-family credentials
# IMS requires Authorization: ApiToken <token>; request token from IMS terms/API page.
IMS_API_TOKEN=

# session and routing config
REQUIRE_SESSION_FOR_TRADES=false
PUBLIC_BASE_URL=http://127.0.0.1:6969/trending
# Production default is exactly https://hachozeh.com. Do not include dev/local origins in prod.
CORS_ALLOWED_ORIGINS=

# optional avatar upload hardening
# Scanner command receives the quarantined upload path as its final argument.
# Example local setup: AVATAR_MALWARE_SCANNER=clamscan and
# AVATAR_MALWARE_SCANNER_ARGS=--no-summary
# If a scanner is configured, scanner execution or detection failure rejects upload.
# Production requires AVATAR_MALWARE_SCANNER and fails avatar uploads closed without it.
AVATAR_MALWARE_SCANNER=
AVATAR_MALWARE_SCANNER_ARGS=
# Optional local/beta fail-closed knob; production is fail-closed regardless.
AVATAR_REQUIRE_MALWARE_SCAN=false

# account-deletion erasure worker.
# Runs inside backend runtime, dry-run/execute CLI also exists.
# Disable only for local debugging or one-off DB maintenance.
ACCOUNT_DELETION_ERASURE_WORKER_ENABLED=true
ACCOUNT_DELETION_ERASURE_WORKER_STARTUP_DELAY_MS=60000
ACCOUNT_DELETION_ERASURE_WORKER_INTERVAL_MS=21600000
ACCOUNT_DELETION_ERASURE_WORKER_LIMIT=50

# privacy retention cleanup worker.
# Runs daily by default and removes expired OTP/session/audit/support leftovers by policy TTL.
PRIVACY_RETENTION_CLEANUP_WORKER_ENABLED=true
PRIVACY_RETENTION_CLEANUP_WORKER_STARTUP_DELAY_MS=120000
PRIVACY_RETENTION_CLEANUP_WORKER_INTERVAL_MS=86400000
