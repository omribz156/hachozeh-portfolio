{
  "name": "@navi/backend",
  "private": true,
  "version": "0.1.0",
  "description": "Navi backend runtime scaffold",
  "scripts": {
    "dev": "node --watch --import tsx src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/back/src/server.js",
    "typecheck": "tsc --noEmit",
    "typecheck:seer": "tsc -p ../seer/tsconfig.json --noEmit",
    "typecheck:oracle": "tsc --noEmit",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "push-gate": "npm run typecheck && npm run typecheck:seer && npm test -- --run",
    "smoke:health": "node --import tsx src/scripts/smoke-health.ts",
    "smoke:market-api": "node --import tsx src/scripts/smoke-market-api.ts",
    "receipt:lifecycle": "node --import tsx src/scripts/lifecycle-event-receipt.ts",
    "smoke:auth-session": "node --import tsx src/scripts/smoke-auth-session.ts",
    "smoke:admin-user-ops": "node --import tsx src/scripts/smoke-admin-user-ops.ts",
    "privacy:account-deletion-erasure": "node --import tsx src/scripts/account-deletion-erasure.ts",
    "privacy:retention-cleanup": "node --import tsx src/scripts/privacy-retention-cleanup.ts",
    "retention:report": "node --import tsx src/scripts/retention-report.ts",
    "ops:usage-snapshot": "node --import tsx src/scripts/platform-usage-snapshot.ts",
    "support:trade-audit": "node --import tsx src/scripts/support-trade-audit.ts",
    "support:profile-moderate": "node --import tsx src/scripts/moderate-user-profile.ts",
    "notify:system": "node --import tsx src/scripts/send-system-notification.ts",
    "doctor:platform": "node --import tsx src/scripts/platform-doctor.ts",
    "doctor:platform:json": "node --import tsx src/scripts/platform-doctor.ts --json",
    "doctor:platform:report": "node --import tsx src/scripts/platform-doctor.ts --report",
    "doctor:platform:deep": "node --import tsx src/scripts/platform-doctor.ts --deep",
    "doctor:production": "node --import tsx src/scripts/platform-doctor.ts --production --deep",
    "doctor:production:report": "node --import tsx src/scripts/platform-doctor.ts --production --deep --report",
    "doctor:production:monitor": "node --import tsx src/scripts/production-doctor.ts --json --alert --alert-on-watch --receipt-path workspace/runtime/doctor/production.jsonl",
    "security:api-exposure": "vitest run --run test/http/api-exposure-guard.test.ts",
    "security:prod-smoke": "node --import tsx src/scripts/prod-security-smoke.ts",
    "integrity:production": "node --import tsx src/scripts/production-integrity-smoke.ts",
    "integrity:production:monitor": "node --import tsx src/scripts/production-integrity-smoke.ts --json --fail-on-watch --alert --alert-on-watch --receipt-path workspace/runtime/integrity/production.jsonl",
    "audit:avatar-storage": "node --import tsx src/scripts/avatar-storage-audit.ts --json",
    "audit:resolution-money": "node --import tsx src/scripts/resolution-money-audit.ts",
    "ops:market-incident-compensation": "node --import tsx src/scripts/market-incident-compensation.ts",
    "ops:market-incident-reopen": "node --import tsx src/scripts/market-incident-reopen.ts",
    "ops:market-incident-finalize": "node --import tsx src/scripts/market-incident-finalize.ts",
    "market:contract-patch": "node --import tsx src/scripts/market-contract-patch.ts",
    "market:integrity-scan": "node --import tsx src/scripts/market-integrity-scan.ts",
    "market:post-incident-audit": "node --import tsx src/scripts/market-post-incident-audit.ts",
    "market:notification-integrity-scan": "node --import tsx src/scripts/notification-integrity-scan.ts",
    "market:pack-lint": "node --import tsx src/scripts/market-pack-lint.ts",
    "event:dependency-doctor": "node --import tsx src/scripts/event-dependency-doctor.ts",
    "event:audit": "node --import tsx src/scripts/event-dependency-doctor.ts --all-active",
    "event:cascade-preview": "node --import tsx src/scripts/event-cascade-preview.ts",
    "lifecycle:queue-doctor": "node --import tsx src/scripts/lifecycle-queue-doctor.ts",
    "market-watch:coverage-doctor": "node --import tsx src/scripts/market-watch-coverage-doctor.ts",
    "market-watch:renew-show-plans": "node --import tsx src/scripts/renew-show-watch-plans.ts",
    "market:incident-impact": "node --import tsx src/scripts/market-incident-impact.ts",
    "market:known-result-trades": "node --import tsx src/scripts/market-known-result-trades.ts",
    "publish:batch-verify": "node --import tsx src/scripts/batch-publish-verify.ts",
    "market:recurring-guard": "node --import tsx src/scripts/recurring-market-guard.ts",
    "oracle:adapter-coverage-map": "node --import tsx src/scripts/source-adapter-coverage-map.ts",
    "ops:receipts-index": "node --import tsx src/scripts/receipts-index.ts",
    "audit:total-volume": "node --import tsx src/scripts/total-volume-reconciliation.ts",
    "audit:candle-backfill": "node --import tsx src/scripts/candle-backfill-audit.ts",
    "economy:bootstrap-platform": "node --import tsx src/scripts/bootstrap-platform-economy.ts",
    "security:db-privileges": "node --import tsx src/scripts/db-privilege-audit.ts",
    "security:db-privileges:strict": "node --import tsx src/scripts/db-privilege-audit.ts --strict",
    "stress:market": "node --import tsx src/scripts/stress-market-engine.ts",
    "stress:cleanup": "node --import tsx src/scripts/stress-market-cleanup.ts",
    "soak:market": "node --import tsx src/scripts/soak-market-movement.ts",
    "depth:lmsr-ladder": "node --import tsx src/scripts/lmsr-depth-ladder.ts",
    "depth:liquidity-audit": "node --import tsx src/scripts/lmsr-liquidity-audit.ts",
    "depth:liquidity-rebase": "node --import tsx src/scripts/lmsr-liquidity-rebase.ts",
    "watchdog:platform": "node --import tsx src/scripts/platform-watchdog.ts",
    "watchdog:platform:loop": "node --import tsx src/scripts/platform-watchdog.ts --loop",
    "watchdog:platform:execute": "node --import tsx src/scripts/platform-watchdog.ts --loop --execute",
    "watchdog:production": "BACKEND_READY_URL=https://hachozeh.com/api/health/ready WATCHDOG_FRONTEND_BASE_URL=https://hachozeh.com WATCHDOG_BACK_SYSTEMD_UNIT=hachozeh-backend.service WATCHDOG_FRONT_SYSTEMD_UNIT=hachozeh-web.service node --import tsx src/scripts/platform-watchdog.ts --loop --execute --failure-threshold=2 --interval-ms=30000",
    "watchdog:platform:gauntlet": "node --import tsx src/scripts/platform-watchdog.ts --loop --iterations=120 --interval-ms=30000 --failure-threshold=2 --prewarm-trending-reads",
    "watchdog:platform:summary": "node --import tsx src/scripts/platform-watchdog.ts --summary",
    "gauntlet:repair-platform": "node --import tsx src/scripts/repair-platform-gauntlet.ts",
    "horizon": "node --import tsx src/scripts/horizon.ts",
    "horizon:close-worker": "node --import tsx src/scripts/horizon.ts close-sweep --limit 50 --json",
    "horizon:scheduler": "node --import tsx src/scripts/horizon-scheduler.ts --jsonl",
    "horizon:scheduler:once": "node --import tsx src/scripts/horizon-scheduler.ts --max-ticks 1 --json",
    "oracle": "node --import tsx ../oracle/src/oracle-cli.ts",
    "oracle:lifecycle-worker": "node --import tsx ../oracle/src/oracle-cli.ts lifecycle-heartbeat --limit 50 --max-ticks 288 --interval-ms 300000 --jsonl",
    "oracle:lifecycle-worker:dry-run": "../oracle/oracle-lifecycle-worker.sh dry-run",
    "oracle:lifecycle-worker:start": "../oracle/oracle-lifecycle-worker.sh start",
    "oracle:lifecycle-worker:stop": "../oracle/oracle-lifecycle-worker.sh stop",
    "oracle:lifecycle-worker:restart": "../oracle/oracle-lifecycle-worker.sh restart",
    "oracle:lifecycle-worker:status": "../oracle/oracle-lifecycle-worker.sh status",
    "oracle:lifecycle-worker:tail": "../oracle/oracle-lifecycle-worker.sh tail",
    "oracle:lifecycle-worker:once": "../oracle/oracle-lifecycle-worker.sh once",
    "oracle:eol-gauntlet": "node --import tsx src/scripts/oracle-eol-gauntlet.ts",
    "oracle:eol-smoke": "node --import tsx src/scripts/oracle-eol-gauntlet.ts --smoke --cleanup true",
    "seer-create": "node --import tsx src/scripts/seer-create.ts",
    "seer:opportunity-watch": "node --import tsx src/scripts/seer-opportunity-watch.ts",
    "market:agent": "node --import tsx src/scripts/agent-market.ts",
    "market:outcome-label": "node --import tsx src/scripts/patch-market-outcome-label.ts",
    "market-watch": "node --import tsx src/scripts/market-watch.ts",
    "event:display-flags": "node --import tsx src/scripts/set-event-display-flags.ts",
    "discovery:curation": "node --import tsx src/scripts/set-discovery-curation.ts",
    "seer": "node --import tsx ../seer/src/main.ts",
    "seed:event-election-ladder": "node --import tsx src/scripts/seed-event-election-ladder.ts",
    "db:migrate": "node --import tsx src/scripts/migrate.ts",
    "db:migrate:plan": "node --import tsx src/scripts/migrate.ts --plan",
    "db:seed": "node --import tsx src/scripts/seed.ts",
    "db:reset": "node --import tsx src/scripts/reset-db.ts",
    "db:bootstrap": "npm run db:migrate && npm run db:seed"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1075.0",
    "@navi/cli": "0.1.0",
    "commander": "^14.0.3",
    "decimal.js": "^10.6.0",
    "dotenv": "^16.6.1",
    "fastify": "^5.12.5",
    "jose": "^4.15.9",
    "pg": "^8.22.0",
    "sharp": "^0.35.4",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^22.20.0",
    "@types/pg": "^8.15.5",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^4.1.9"
  }
}
